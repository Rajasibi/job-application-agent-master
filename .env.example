# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- LLM backend: local | ollama_cloud (local Ollama is always the fallback) ---
# Cloud: create a key at ollama.com -> Settings -> Keys and put it here (never in code or chat).
LLM_BACKEND=local
OLLAMA_CLOUD_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_CLOUD_MODEL=
LLM_CLOUD_TIMEOUT_MS=90000
LLM_CLOUD_RETRIES=2
LLM_FALLBACK_LOCAL=true
LLM_CONCURRENCY=1

# --- Browserless: optional headless Chromium; local by default ---
BROWSERLESS_ENABLED=false
BROWSERLESS_ENDPOINT=https://production-sfo.browserless.io
BROWSERLESS_TOKEN=
BROWSERLESS_BYPASS=false

# --- Pipeline ---
# Jobs scoring at or above this are tailored + prepared for review
FIT_THRESHOLD=70
N8N_WEBHOOK_URL=http://localhost:5678

# --- Google Sheets (optional; local log works without it) ---
# Sheet ID is the long string between /d/ and /edit in the sheet URL. Tab must be named "Applications".
# The service-account key stays in its own JSON file (gitignored); share the sheet with its client_email as Editor.
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_SERVICE_ACCOUNT_FILE=config/google-service-account.json
