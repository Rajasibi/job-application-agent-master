{
  "id": "foundit-scraper-workflow",
  "name": "Scraper — foundit",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3-23/4 * * *"
            }
          ]
        }
      },
      "id": "d3d51aa4-b8a3-40d5-a50f-9bf6308bea58",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {},
      "id": "26785588-0f7a-4d44-b406-d49ab9d59c39",
      "name": "Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        500
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "run-scraper-foundit",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "9bf17786-71aa-4906-93dc-5adddd983c02",
      "webhookId": "064e5aa8-5766-46dd-b094-1347d6919421",
      "name": "Run From Dashboard",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        700
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:9999/scrape/foundit",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 2400000
        }
      },
      "id": "b1994f21-9d73-4431-bd9c-ef782dd7b57f",
      "name": "Scrape foundit",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nif (r.error) throw new Error('Scraper error: ' + r.error);\nreturn (r.jobs || []).map(j => ({ json: j }));"
      },
      "id": "9551cc31-4e3b-4708-bf88-75d63cb52149",
      "name": "One Item Per Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/score-job",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 5400000
        }
      },
      "id": "c26a12eb-f8b3-45e3-9e95-83a219b79cb3",
      "name": "Score Job (one at a time)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "c3671b3d-558d-483b-9c79-9d6f82c054bb",
      "name": "Loop Over Jobs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
