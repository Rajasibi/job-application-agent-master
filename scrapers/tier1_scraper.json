            "index": 0
          }
        ]
      ]
    },
    "Scrape tier1": {
      "main": [
        [
          {
            "node": "One Item Per Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One Item Per Job": {
      "main": [
        [
          {
            "node": "Loop Over Jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Jobs": {
      "main": [
        [],
        [
          {
            "node": "Score Job (one at a time)",
            "type": "main",
            "index": 0
          }
        ]
      ]
