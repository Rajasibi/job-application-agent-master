{
  "id": "tier1-scraper-workflow",
  "name": "Scraper — Tier 1 Career Pages",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 3-23/6 * * *"
            }
          ]
        }
      },
      "id": "a29835e6-9f78-4396-b97b-238fcfe5499c",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {},
      "id": "bc0d42cd-445d-4487-97dd-27db984c3c53",
      "name": "Run Manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        500
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "run-scraper-tier1",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "e32406eb-9d08-4896-a418-ffde4857391d",
      "webhookId": "79dda1aa-63b6-41e8-861c-b0748728ba7e",
      "name": "Run From Dashboard",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        700
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:9999/scrape/tier1",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "timeout": 2400000
        }
      },
      "id": "64a99c96-f3e0-41e1-b35d-8311d45af5cd",
      "name": "Scrape tier1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $input.first().json;\nif (r.error) throw new Error('Scraper error: ' + r.error);\nreturn (r.jobs || []).map(j => ({ json: j }));"
      },
      "id": "a66e6d9c-d059-4775-918a-dd3eea4056f8",
      "name": "One Item Per Job",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:5678/webhook/score-job",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 5400000
        }
      },
      "id": "f9d9bcba-8732-47f0-afb7-1c66485b8e46",
      "name": "Score Job (one at a time)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "7fb4e7d6-e6ac-421c-8821-0f6f149686c5",
      "name": "Loop Over Jobs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        900,
        300
      ]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [
        [
          {
            "node": "Scrape tier1",
            "type": "main",
            "index": 0
          }
        ]
      ]
