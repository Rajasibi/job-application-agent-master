      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// tier1_* -> Tier 1 agent, India jobs -> India agent, everything else -> Abroad agent\nconst job = $json.job;\nconst p = String(job.source_platform || '');\nconst target = p.startsWith('tier1') ? 'apply-tier1' : (job.region === 'india' ? 'apply-india' : 'apply-abroad');\nreturn { json: { job, target } };"
      },
